<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/Quest.uss?fileID=7433441132597879392&amp;guid=4f1283c5758274f448b1a935dd98ffb2&amp;type=3#Quest"/>
    <ui:VisualElement class="quest-root" style="flex-grow: 0; align-self: flex-start;">
        <ui:Label text="Quest" class="quest-title"/>
        <ui:VisualElement class="quest-row">
            <ui:Label text="DaysToComplete" class="quest-field-label"/>
            <ui:Label name="DaysToCompleteValue" text="0"/>
        </ui:VisualElement>
        <ui:VisualElement class="quest-row">
            <ui:Label text="Requirement" class="quest-field-label"/>
            <ui:Label name="RequirementValue" text="0"/>
        </ui:VisualElement>
        <ui:VisualElement class="quest-row">
            <ui:Label text="Reward" class="quest-field-label"/>
            <ui:Label name="RewardValue" text="0"/>
        </ui:VisualElement>
        <ui:VisualElement class="quest-row">
            <ui:Label text="SizePenalty" class="quest-field-label"/>
            <ui:Label name="SizePenaltyValue" text="0"/>
        </ui:VisualElement>
        <ui:VisualElement class="quest-row">
            <ui:Label text="HealthPenalty" class="quest-field-label"/>
            <ui:Label name="HealthPenaltyValue" text="0"/>
        </ui:VisualElement>
        <ui:VisualElement class="quest-row">
            <ui:Button text="Accept" name="Accept" class="quest-button"/>
            <ui:Button text="Decline" name="Decline" class="quest-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
